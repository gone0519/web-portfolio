<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@300;400;500;600&family=Noto+Sans+JP:wght@400;500&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
<script src="./image-slot.js"></script>
<style>
html{scroll-behavior:smooth}
body{margin:0;background:#fff;color:#2a2a28;font-family:'Noto Serif JP',serif;-webkit-font-smoothing:antialiased}
*{box-sizing:border-box}
a{color:#8a1414;text-decoration:none}
a:hover{color:#5e0c0c}
input,textarea{font-family:inherit}
</style>
</helmet>
<dc-import name="SiteHeader" current="contact" hint-size="100%,44px"></dc-import>
<main>
<section data-screen-label="Contact Hero" style="position:relative;height:48vh;min-height:340px;max-height:540px;overflow:hidden;background:#141412;color:#fff">
  <div data-hero-parallax="1" style="position:absolute;inset:-12% 0 0 0"><image-slot id="contact-hero" shape="rect" placeholder="CONTACT HERO — 農園の入口・直売所"></image-slot></div>
  <div style="position:absolute;inset:0;pointer-events:none;background:linear-gradient(180deg,rgba(10,10,9,0.5),rgba(10,10,9,0.35) 50%,rgba(10,10,9,0.6))"></div>
  <div style="position:relative;height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;text-align:center;padding:64px 20px 20px;pointer-events:none">
    <span data-intro="first" style="font-family:'Cormorant Garamond',serif;font-size:13px;letter-spacing:0.4em;color:rgba(255,255,255,0.75)">05</span>
    <h1 data-split="1" style="margin:0;font-family:'Cormorant Garamond',serif;font-weight:500;font-size:clamp(42px,7vw,96px);letter-spacing:0.3em;padding-left:0.3em;line-height:1">CONTACT</h1>
    <p data-intro="1" style="margin:0;font-size:16px;letter-spacing:0.4em;padding-left:0.4em">お問い合わせ</p>
  </div>
  <dc-import name="GrassEdge" color="#ffffff" height="56" seed="13" style="position:absolute;left:0;right:0;bottom:-1px;z-index:3" hint-size="100%,56px"></dc-import>
</section>
<nav aria-label="パンくずリスト" style="max-width:1160px;margin:0 auto;padding:18px 24px;display:flex;gap:12px;font-family:'Cormorant Garamond',serif;font-size:13px;letter-spacing:0.2em;color:#8a877d">
  <a href="Farm%20Website.dc.html" style="color:#8a877d">HOME</a><span>/</span><span style="color:#2a2a28">CONTACT</span>
</nav>

<section data-screen-label="Intro" style="max-width:760px;margin:0 auto;padding:clamp(48px,6vw,80px) 24px 0;text-align:center;display:flex;flex-direction:column;align-items:center;gap:14px">
  <h2 style="margin:0;color:#8a1414;font-weight:600;font-size:clamp(24px,3.2vw,38px);letter-spacing:0.08em;line-height:1.6">「農業の未来を、ともにつくる。」</h2>
  <p style="margin:0;font-size:14.5px;line-height:2.1;letter-spacing:0.05em;color:#3d3b36;text-wrap:pretty">商品のご購入、卸・業務用のお取引、飲食店さまからのご相談、協業、採用など、お気軽にお問い合わせください。内容を確認のうえ、担当者よりご連絡いたします。</p>
  <div style="margin-top:20px;width:100%;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));border-top:1px solid #2a2a28;border-bottom:1px solid #2a2a28">
    <div style="padding:24px;display:flex;flex-direction:column;gap:6px;align-items:center">
      <span style="font-size:12px;letter-spacing:0.18em;color:#6b685f">お電話でのお問い合わせ</span>
      <a href="tel:000-000-0000" style="font-family:'Cormorant Garamond',serif;font-size:34px;letter-spacing:0.06em;color:#141412;line-height:1.2">000-000-0000</a>
      <span style="font-size:12px;color:#6b685f">平日 0:00〜00:00（土日祝を除く）</span>
    </div>
    <div style="padding:24px;display:flex;flex-direction:column;gap:6px;align-items:center;border-left:1px solid #d9d5ca">
      <span style="font-size:12px;letter-spacing:0.18em;color:#6b685f">FAX / メール</span>
      <span style="font-family:'Cormorant Garamond',serif;font-size:26px;letter-spacing:0.06em;line-height:1.3">000-000-0000</span>
      <a href="mailto:info@example.com" style="font-size:14px">info@example.com</a>
    </div>
  </div>
</section>

<section data-screen-label="Form" style="max-width:820px;margin:0 auto;padding:clamp(60px,7vw,96px) 24px">
  <div style="display:flex;flex-direction:column;gap:12px;align-items:center;text-align:center;margin-bottom:40px">
    <span style="display:inline-flex;align-items:flex-end;gap:10px;font-family:'Cormorant Garamond',serif;font-size:13px;letter-spacing:0.4em;color:#8a1414"><dc-import name="Sprout" color="#8a1414" hint-size="18px,16px"></dc-import>FORM</span>
    <h2 style="margin:0;font-weight:500;font-size:clamp(22px,2.6vw,30px);letter-spacing:0.14em">お問い合わせフォーム</h2>
  </div>
  <sc-if value="{{ sent }}" hint-placeholder-val="{{ false }}">
    <div role="status" style="background:#f6f4ee;padding:56px 28px;text-align:center;display:flex;flex-direction:column;align-items:center;gap:16px">
      <span style="font-size:22px;color:#8a1414;letter-spacing:0.12em">送信が完了しました。</span>
      <p style="margin:0;font-size:14px;line-height:2;color:#3d3b36">お問い合わせありがとうございます。<br>内容を確認のうえ、担当者よりご連絡いたします。</p>
      <button onClick="{{ reset }}" style="margin-top:10px;min-height:48px;padding:0 28px;background:none;border:1px solid #8a1414;color:#8a1414;font-family:'Noto Serif JP',serif;font-size:14px;letter-spacing:0.14em;cursor:pointer">フォームに戻る</button>
    </div>
  </sc-if>
  <sc-if value="{{ notSent }}" hint-placeholder-val="{{ true }}">
    <form onSubmit="{{ submit }}" novalidate="novalidate" style="display:flex;flex-direction:column;gap:28px">
      <fieldset style="border:0;margin:0;padding:0;display:flex;flex-direction:column;gap:12px">
        <legend style="padding:0;margin-bottom:12px;font-size:14px;letter-spacing:0.1em">お問い合わせ種別 <span style="color:#8a1414;font-size:12px;margin-left:6px">必須</span></legend>
        <div style="display:flex;flex-wrap:wrap;gap:8px">
          <sc-for list="{{ topics }}" as="t" hint-placeholder-count="7">
            <button type="button" aria-pressed="{{ t.on }}" onClick="{{ t.pick }}" style="min-height:44px;padding:0 18px;border:1px solid {{ t.border }};background:{{ t.bg }};color:{{ t.color }};font-family:'Noto Serif JP',serif;font-size:13px;letter-spacing:0.08em;cursor:pointer;transition:all .25s">{{ t.label }}</button>
          </sc-for>
        </div>
      </fieldset>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:24px">
        <label style="display:flex;flex-direction:column;gap:10px;font-size:14px;letter-spacing:0.1em">
          <span>お名前 <span style="color:#8a1414;font-size:12px;margin-left:6px">必須</span></span>
          <input type="text" autocomplete="name" value="{{ f.name }}" onChange="{{ on.name }}" placeholder="山田 太郎" style="min-height:52px;padding:0 16px;border:1px solid {{ err.name }};background:#fff;font-size:15px;outline-color:#8a1414">
        </label>
        <label style="display:flex;flex-direction:column;gap:10px;font-size:14px;letter-spacing:0.1em">
          <span>会社名・店舗名</span>
          <input type="text" autocomplete="organization" value="{{ f.company }}" onChange="{{ on.company }}" placeholder="任意" style="min-height:52px;padding:0 16px;border:1px solid #c9c4b6;background:#fff;font-size:15px;outline-color:#8a1414">
        </label>
        <label style="display:flex;flex-direction:column;gap:10px;font-size:14px;letter-spacing:0.1em">
          <span>メールアドレス <span style="color:#8a1414;font-size:12px;margin-left:6px">必須</span></span>
          <input type="email" autocomplete="email" value="{{ f.email }}" onChange="{{ on.email }}" placeholder="example@example.com" style="min-height:52px;padding:0 16px;border:1px solid {{ err.email }};background:#fff;font-size:15px;outline-color:#8a1414">
        </label>
        <label style="display:flex;flex-direction:column;gap:10px;font-size:14px;letter-spacing:0.1em">
          <span>電話番号</span>
          <input type="tel" autocomplete="tel" value="{{ f.tel }}" onChange="{{ on.tel }}" placeholder="任意" style="min-height:52px;padding:0 16px;border:1px solid #c9c4b6;background:#fff;font-size:15px;outline-color:#8a1414">
        </label>
      </div>
      <label style="display:flex;flex-direction:column;gap:10px;font-size:14px;letter-spacing:0.1em">
        <span>お問い合わせ内容 <span style="color:#8a1414;font-size:12px;margin-left:6px">必須</span></span>
        <textarea rows="7" value="{{ f.msg }}" onChange="{{ on.msg }}" placeholder="ご質問・ご相談内容をご記入ください" style="padding:14px 16px;border:1px solid {{ err.msg }};background:#fff;font-size:15px;line-height:1.9;resize:vertical;outline-color:#8a1414"></textarea>
      </label>
      <label style="display:flex;align-items:center;justify-content:center;gap:12px;font-size:14px;letter-spacing:0.06em;min-height:44px;cursor:pointer">
        <input type="checkbox" checked="{{ f.agree }}" onChange="{{ onAgree }}" style="width:20px;height:20px;accent-color:#8a1414">
        <span><a href="#" style="text-decoration:underline">個人情報の取り扱い</a>に同意する</span>
      </label>
      <sc-if value="{{ showError }}" hint-placeholder-val="{{ false }}">
        <p role="alert" style="margin:0;text-align:center;color:#8a1414;font-size:13px;letter-spacing:0.06em">必須項目の入力と、個人情報の取り扱いへの同意をお願いいたします。</p>
      </sc-if>
      <button type="submit" style="align-self:center;min-height:60px;min-width:260px;padding:0 36px;background:#8a1414;border:0;color:#fff;font-family:'Noto Serif JP',serif;font-size:16px;letter-spacing:0.2em;cursor:pointer;transition:background .3s" style-hover="background:#a51c1c">送信する</button>
    </form>
  </sc-if>
</section>

<div aria-hidden="true" style="position:relative;height:0;z-index:2"><dc-import name="GrassEdge" color="#f6f4ee" height="60" seed="53" style="position:absolute;left:0;right:0;bottom:-1px" hint-size="100%,60px"></dc-import></div>
<section id="access" data-screen-label="Access" style="background:#f6f4ee;padding:clamp(80px,9vw,120px) clamp(20px,5vw,72px)">
  <div style="max-width:1160px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,400px),1fr));gap:clamp(32px,5vw,64px);align-items:center">
    <div style="position:relative;aspect-ratio:4/3"><image-slot id="contact-map" shape="rect" placeholder="地図（Google マップの埋め込み・画像）"></image-slot></div>
    <div data-reveal="1" style="display:flex;flex-direction:column;gap:18px">
      <span style="display:inline-flex;align-items:flex-end;gap:10px;font-family:'Cormorant Garamond',serif;font-size:13px;letter-spacing:0.4em;color:#8a1414"><dc-import name="Sprout" color="#8a1414" hint-size="18px,16px"></dc-import>ACCESS</span>
      <h2 style="margin:0;font-weight:500;font-size:clamp(22px,2.6vw,30px);letter-spacing:0.14em">農園・直売所へのアクセス</h2>
      <dl style="margin:0;display:grid;grid-template-columns:auto 1fr;gap:12px 22px;font-size:14px;line-height:1.9;letter-spacing:0.05em;color:#3d3b36">
        <dt style="color:#8a1414">所在地</dt><dd style="margin:0">〒000-0000 ○○県○○市○○町 0-0-0</dd>
        <dt style="color:#8a1414">お車</dt><dd style="margin:0">○○ICより約○○分（駐車場 ○台）</dd>
        <dt style="color:#8a1414">公共交通</dt><dd style="margin:0">○○駅より車で約○○分</dd>
        <dt style="color:#8a1414">直売所</dt><dd style="margin:0">0:00〜00:00（定休日：○曜日）</dd>
      </dl>
    </div>
  </div>
</section>

<section data-screen-label="FAQ" style="max-width:860px;margin:0 auto;padding:clamp(80px,9vw,120px) 24px">
  <div style="display:flex;flex-direction:column;gap:12px;align-items:center;text-align:center;margin-bottom:40px">
    <span style="display:inline-flex;align-items:flex-end;gap:10px;font-family:'Cormorant Garamond',serif;font-size:13px;letter-spacing:0.4em;color:#8a1414"><dc-import name="Sprout" color="#8a1414" hint-size="18px,16px"></dc-import>FAQ</span>
    <h2 style="margin:0;font-weight:500;font-size:clamp(22px,2.6vw,30px);letter-spacing:0.14em">よくあるご質問</h2>
  </div>
  <div style="border-top:1px solid #2a2a28">
    <sc-for list="{{ faq }}" as="q" hint-placeholder-count="4">
      <div style="border-bottom:1px solid #d9d5ca">
        <button aria-expanded="{{ q.open }}" onClick="{{ q.toggle }}" style="width:100%;min-height:64px;padding:18px 4px;background:none;border:0;display:flex;align-items:center;gap:18px;text-align:left;cursor:pointer;font-family:'Noto Serif JP',serif;font-size:15px;letter-spacing:0.06em;color:#2a2a28">
          <span style="font-family:'Cormorant Garamond',serif;font-size:22px;color:#8a1414">Q</span>
          <span style="flex:1">{{ q.q }}</span>
          <span style="font-size:20px;color:#8a877d;width:20px;text-align:center">{{ q.sign }}</span>
        </button>
        <sc-if value="{{ q.open }}" hint-placeholder-val="{{ false }}">
          <div style="display:flex;gap:18px;padding:0 4px 24px">
            <span style="font-family:'Cormorant Garamond',serif;font-size:22px;color:#8a877d;line-height:1.4">A</span>
            <p style="margin:0;font-size:14px;line-height:2;letter-spacing:0.04em;color:#3d3b36">{{ q.a }}</p>
          </div>
        </sc-if>
      </div>
    </sc-for>
  </div>
</section>
</main>
<dc-import name="SiteFooter" hint-size="100%,260px"></dc-import>
</x-dc>
<script type="text/x-dc" data-dc-script>
class Component extends DCLogic {
  topicList = ['商品について', '卸・業務用', '飲食店・食品事業者さま', '協業・パートナーシップ', '採用', '取材・視察', 'その他'];
  constructor(p) {
    super(p);
    const t = new URLSearchParams(location.search).get('type');
    const map = { business: '卸・業務用', recruit: '採用' };
    this.state = { type: map[t] || '商品について', f: { name: '', company: '', email: '', tel: '', msg: '', agree: false }, tried: false, sent: false, open: 0 };
  }
  set(k, v) { this.setState(s => ({ f: { ...s.f, [k]: v } })); }
  valid() { const f = this.state.f; return f.name.trim() && /\S+@\S+\.\S+/.test(f.email) && f.msg.trim() && f.agree; }
  renderVals() {
    const { f, tried, type } = this.state;
    const bad = (ok) => tried && !ok ? '#8a1414' : '#c9c4b6';
    const faqs = [
      ['個人での購入はできますか？', '直売所またはオンラインショップでお求めいただけます。詳細はここに記載してください。'],
      ['業務用の少量取引は可能ですか？', '数量・頻度についてはご相談に応じます。お問い合わせフォームよりご連絡ください。'],
      ['農園の見学はできますか？', '時期や作業状況により異なります。事前にお問い合わせください。'],
      ['返信までどのくらいかかりますか？', '通常○営業日以内にご連絡いたします。（仮）']
    ];
    return {
      sent: this.state.sent, notSent: !this.state.sent,
      reset: () => this.setState({ sent: false, tried: false, f: { name: '', company: '', email: '', tel: '', msg: '', agree: false } }),
      topics: this.topicList.map(label => ({ label, on: label === type, bg: label === type ? '#8a1414' : '#fff', color: label === type ? '#fff' : '#3d3b36', border: label === type ? '#8a1414' : '#c9c4b6', pick: () => this.setState({ type: label }) })),
      f,
      on: Object.fromEntries(['name', 'company', 'email', 'tel', 'msg'].map(k => [k, e => this.set(k, e.target.value)])),
      onAgree: e => this.set('agree', e.target.checked),
      err: { name: bad(f.name.trim()), email: bad(/\S+@\S+\.\S+/.test(f.email)), msg: bad(f.msg.trim()) },
      showError: tried && !this.valid(),
      submit: e => { e.preventDefault(); if (this.valid()) { this.setState({ sent: true }); window.scrollTo({ top: window.scrollY - 200, behavior: 'smooth' }); } else this.setState({ tried: true }); },
      faq: faqs.map(([q, a], i) => ({ q, a, open: this.state.open === i, sign: this.state.open === i ? '−' : '+', toggle: () => this.setState(s => ({ open: s.open === i ? -1 : i })) }))
    };
  }
}
</script>
</body>
</html>
